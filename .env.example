# Template for the gitignored `.env` that scripts/sync_meetup.rb reads on local
# runs. Copy to `.env` and fill in the values from the Meetup OAuth app.
#
# In CI these four come from repo secrets instead, and MEETUP_PRIVATE_KEY holds
# the PEM *contents* (there is no file on the runner to point at).

MEETUP_CLIENT_KEY=
MEETUP_MEMBER_ID=
MEETUP_SIGNING_KEY_ID=

# Path to the RSA private key PEM. Relative paths resolve against the repo root,
# so `./meetup-private-key.pem` works from any working directory.
MEETUP_PRIVATE_KEY_PATH=./meetup-private-key.pem

# Alternative to the path: the PEM contents inline. Used by CI.
# MEETUP_PRIVATE_KEY=
